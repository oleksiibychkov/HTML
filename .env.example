# ============================================
# КОНФІГУРАЦІЯ СЕРВЕРА
# ============================================
# Скопіюй цей файл як .env і заповни значення

# Порт сервера
PORT=3000

# Секретний ключ для сесій (згенеруй випадковий рядок)
SESSION_SECRET=your-super-secret-key-change-this

# ============================================
# БАЗА ДАНИХ
# ============================================
# Шлях до файлу SQLite (відносно кореня проекту)
DATABASE_PATH=./database/testhub.db

# ============================================
# CLAUDE AI API
# ============================================
# Отримай ключ на https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Модель для перевірки робіт
CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================
# ФАЙЛИ
# ============================================
# Папка для завантажених PDF
UPLOADS_DIR=./uploads

# Максимальний розмір файлу (в байтах, 10MB)
MAX_FILE_SIZE=10485760

# ============================================
# БЕЗПЕКА
# ============================================
# Час життя сесії (в годинах)
SESSION_LIFETIME_HOURS=24

# Дозволені домени для CORS (через кому)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
